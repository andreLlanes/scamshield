# ============================================================================
# ScamShield — environment template
# Copy to `.env` at the repo root (backend reads it) and adjust as needed.
# Every value below is a default that already works out of the box.
# ============================================================================

# ---- Application ----------------------------------------------------------
SCAMSHIELD_ENVIRONMENT=development
SCAMSHIELD_DEBUG=true
SCAMSHIELD_API_PREFIX=/api/v1
SCAMSHIELD_CORS_ORIGINS=["http://localhost:3000"]

# ---- Database -------------------------------------------------------------
# SQLite by default; swap in PostgreSQL for production.
SCAMSHIELD_DATABASE_URL=sqlite+aiosqlite:///./var/scamshield.db
# SCAMSHIELD_DATABASE_URL=postgresql+asyncpg://scamshield:scamshield@localhost:5432/scamshield

# ---- Object storage -------------------------------------------------------
# local | s3
SCAMSHIELD_STORAGE_BACKEND=local
SCAMSHIELD_STORAGE_LOCAL_PATH=./var/uploads
SCAMSHIELD_S3_BUCKET=
SCAMSHIELD_S3_REGION=ap-southeast-1
SCAMSHIELD_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Agent 1: transcription (Whisper large-v3) ----------------------------
# auto | faster-whisper | transformers | openai-whisper | stub
SCAMSHIELD_TRANSCRIPTION_BACKEND=faster-whisper
SCAMSHIELD_WHISPER_MODEL=large-v3
SCAMSHIELD_WHISPER_DEVICE=auto            # auto | cpu | cuda
SCAMSHIELD_WHISPER_COMPUTE_TYPE=int8      # faster-whisper only
SCAMSHIELD_WHISPER_LANGUAGE=en              # blank = auto-detect (en / tl)
SCAMSHIELD_MAX_UPLOAD_MB=50

# ---- Agent 2: classical ML scam classifier --------------------------------
SCAMSHIELD_CLASSIFIER_MODEL_PATH=./artifacts/scam_classifier.joblib

# ---- Agent 3: RAG fact verification ---------------------------------------
SCAMSHIELD_CHROMA_PATH=./data/chroma
SCAMSHIELD_CHROMA_COLLECTION=scamshield_kb
SCAMSHIELD_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SCAMSHIELD_KNOWLEDGE_BASE_PATH=./data/knowledge_base
SCAMSHIELD_RAG_TOP_K=4

# ---- LLM (CrewAI agents) --------------------------------------------------
# Provider is inferred from the model string by LiteLLM.
#   Ollama (local, free)  -> ollama/llama3.1:8b   + SCAMSHIELD_LLM_BASE_URL
#   Anthropic             -> anthropic/claude-sonnet-5   + ANTHROPIC_API_KEY
#   OpenAI                -> openai/gpt-4o-mini          + OPENAI_API_KEY
SCAMSHIELD_LLM_MODEL=ollama/llama3.1:8b
SCAMSHIELD_LLM_BASE_URL=http://localhost:11434
SCAMSHIELD_LLM_TEMPERATURE=0.1
SCAMSHIELD_LLM_MAX_TOKENS=2048
SCAMSHIELD_LLM_TIMEOUT_SECONDS=180
# Set false to force the deterministic rule-based analyzers (no LLM required).
SCAMSHIELD_AGENTS_ENABLED=true

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---- Scoring weights (must sum to 1.0) ------------------------------------
SCAMSHIELD_WEIGHT_CLASSIFIER=0.4
SCAMSHIELD_WEIGHT_SOCIAL_ENGINEERING=0.35
SCAMSHIELD_WEIGHT_FACT_CHECK=0.25

# ---- Frontend (Next.js) ---------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
